[Unit]
Description=SDIS FastAPI (webhooks + read API)
After=network-online.target

[Service]
User=sdis
EnvironmentFile=/etc/sdis/sdis.env
WorkingDirectory=/opt/sdis/repo
ExecStart=/opt/sdis/venv/bin/uvicorn sdis.api:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
