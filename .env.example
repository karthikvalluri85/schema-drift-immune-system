# Copy to .env (never commit .env). Everything is optional for demo mode.
# --- Snowflake (key-pair auth; see snowflake/00_setup_account.sql) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SDIS_AGENT_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=./keys/sdis_agent.p8
SNOWFLAKE_DBT_USER=SDIS_DBT_SVC
SNOWFLAKE_DBT_PRIVATE_KEY_PATH=./keys/sdis_dbt.p8
SDIS_CORTEX_MODEL=claude-sonnet-4-5
# --- GitHub (fine-grained token: contents + pull requests read/write on this repo) ---
GITHUB_REPOSITORY=karthikvalluri85/schema-drift-immune-system
GITHUB_TOKEN=
# --- Jira Cloud (API token from id.atlassian.com → Security → API tokens) ---
JIRA_BASE_URL=https://karthikvalluri1985.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SDIS
# --- SDIS API ---
SDIS_API_TOKEN=
GITHUB_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
